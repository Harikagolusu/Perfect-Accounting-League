{"id":"13e5db28-3a5a-4b87-9fd7-3b4b7f5fc505","change":{"type":"traceability","change":{"action":"observe","id":"08e555b5-a2d6-467f-be19-4677e001b0a8:call_9938425bee0b447cbc78fca2","tool":"read_file","input":{"command":""},"ok":true,"output":{"traceSummary":"\"\"\"Invoice extraction over a provider-agnostic, text-first pipeline.\n\nThe extractor owns the seam between PAL and an AI provider:\n\n    Document -> routing -> text / OCR / structured / vision -> AIProvider\n             -> strict schema -> deterministic validation\n\nRouting is deliberate:\n\n* digital PDFs are read from their native text layer and never rasterised;\n* scanned PDFs go native text -> OCR -> bounded page images (vision);\n* JPEG/PNG go straight to vision;\n* XLSX/XLS/DOCX are read as structured text and sent to a text model.\n\nThe provider contract is split into text and vision capabilities, so a\ntext-only provider can process digital documents and a vision-only provider can\nstill handle images. No provider-specific exception, key, prompt, local path or\nraw response leaves this module.\n\nThe extractor does not write to the database. It returns an `ExtractionResult`\nand lets the invoice service apply the lifecycle and persistence rules.\n\"\"\"\n\nfrom __future__ import annotations\n\nimpor","sourceLineHashes":["9388d45b2706cf0ada3d36f9a68269c1360b68db6aac16d04e8a3ba54818dc51","b96d2206b865f2d2f5f2c8836961684308292637df3556a166d8626ec3c5ee6e","197bebc4615eb070ab272c0b6bce1a8fd115dde45bec2b90b1450e0885d80d7c","965415ab07c1d1bc13095a0b32ad3016b12663c75036acd53f295a51a67cf889","a87313d5b78f7a57b9b55b85b894fabb9c23b434db2825f36b45fb140fae878a","7d20dbaf14a46bcda122b53bdbf676be559b16268db07ba3a266b8d6f374537d","674d18a3f29f3a3dc24b0de0f05cf4febde57a750e26e6cf75df2069a80506c7","0a4a096eb8b4c6f68f89761e6410ac5c3b7b8dd3fd227d6ca9e3dffb8c48fc29","15b237da0ae26d8def170b8591157a1df10857ef33860055f0486ec3bc097703","73c044e9fb35b68838a780d2b8bfd1303c12a7ead928afbef34f7f6c2c8bd493","6334e4839275c91107