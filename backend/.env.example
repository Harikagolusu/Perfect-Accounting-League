# Application
APP_NAME=PAL Accounting Automation API
APP_ENV=development
DEBUG=true

# Database
# Adjust the credentials to match your local PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pal_db

# API
API_V1_PREFIX=/api/v1

# CORS - comma-separated list of allowed origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173