# Application
APP_NAME=PAL Accounting Automation API
APP_ENV=development
DEBUG=true

# Database
# Adjust the credentials to match your local PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pal_db

# API
API_V1_PREFIX=/api/v1

# CORS - comma-separated list of allowed origins (frontend dev server).
# The TanStack preset serves the frontend on http://localhost:8080.
# Keep both localhost and 127.0.0.1: browsers treat them as different origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Document Inbox storage
# Local directory for uploaded documents. Keep it on the machine PAL runs on;
# uploaded accounting documents are not sent anywhere. A relative path
# resolves against the directory the backend process runs in.
DOCUMENT_STORAGE_PATH=./storage/documents

# Maximum accepted upload size in bytes (20 MB).
DOCUMENT_MAX_UPLOAD_BYTES=20971520

# AI Provider (DeepSeek)
# NEVER commit a real API key. This is only a placeholder for local development.
# Get your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Invoice extraction
# Maximum PDF pages sent to the vision model in one request. Documents above
# this limit are rejected for review, never silently truncated.
INVOICE_MAX_PAGES=10

# TallyPrime integration (read-only POC)
# TallyPrime must be running as a server on this port. The URL is server-side
# configuration only; PAL never accepts a Tally URL from an API caller.
TALLY_BASE_URL=http://localhost:9000
# Must be greater than 0 and no more than 60 seconds.
TALLY_TIMEOUT_SECONDS=10