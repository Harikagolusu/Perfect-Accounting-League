# Application
APP_NAME=PAL Accounting Automation API
APP_ENV=development
DEBUG=true

# Database
# Adjust the credentials to match your local PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pal_db

# API
API_V1_PREFIX=/api/v1

# CORS - comma-separated list of allowed origins (frontend dev server).
# The TanStack preset serves the frontend on http://localhost:8080.
# Add http://localhost:5173 here too if you run Vite on a different port.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173